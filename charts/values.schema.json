{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant", "infisical", "oidc", "tls", "ingressRoute", "poolDefaults"],
  "definitions": {
    "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63 },
    "middlewares": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "namespace": { "type": "string" }
        }
      }
    },
    "routeOverrides": {
      "entryPoints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
      "ingressClass": { "type": "string", "minLength": 1 },
      "middlewares": { "$ref": "#/definitions/middlewares" },
      "tlsSecretName": { "type": "string" }
    }
  },
  "properties": {
    "tenant": {
      "type": "object",
      "required": ["name", "configSecret", "pools"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "configSecret": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "existingSecret": { "type": "boolean" }
          }
        },
        "pools": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    },
    "ingress": { "type": "object" },
    "extraResources": { "type": "array" },
    "infisical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authRef", "projectSlug", "environmentSlug", "secretPath", "recursive", "refreshInterval"],
      "properties": {
        "authRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "namespace"],
          "properties": {
            "name": { "type": "string" },
            "namespace": { "type": "string" }
          }
        },
        "projectSlug": { "type": "string" },
        "environmentSlug": { "type": "string" },
        "secretPath": { "type": "string", "pattern": "^/" },
        "recursive": { "type": "boolean" },
        "refreshInterval": { "type": "string", "minLength": 1 }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "configUrl", "scopes", "redirectUriDynamic", "displayName"],
      "properties": {
        "enabled": { "type": "boolean" },
        "configUrl": { "type": "string" },
        "scopes": { "type": "string", "minLength": 1 },
        "redirectUriDynamic": { "enum": ["on", "off"] },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "issuerRef", "externalCertSecrets"],
      "properties": {
        "enabled": { "type": "boolean" },
        "issuerRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind"],
          "properties": {
            "name": { "type": "string" },
            "kind": { "enum": ["ClusterIssuer", "Issuer"] }
          }
        },
        "organization": { "type": "string" },
        "externalCertSecrets": { "type": "array", "items": { "$ref": "#/definitions/name" } }
      }
    },
    "ingressRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "entryPoints", "ingressClass", "middlewares", "tlsSecretName", "console", "api"],
      "properties": {
        "enabled": { "type": "boolean" },
        "entryPoints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "ingressClass": { "type": "string", "minLength": 1 },
        "middlewares": { "$ref": "#/definitions/middlewares" },
        "tlsSecretName": { "type": "string" },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host"],
          "properties": {
            "host": { "type": "string" },
            "entryPoints": { "$ref": "#/definitions/routeOverrides/entryPoints" },
            "ingressClass": { "$ref": "#/definitions/routeOverrides/ingressClass" },
            "middlewares": { "$ref": "#/definitions/middlewares" },
            "tlsSecretName": { "$ref": "#/definitions/routeOverrides/tlsSecretName" }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts"],
          "properties": {
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["host"],
                "properties": {
                  "name": { "$ref": "#/definitions/name" },
                  "host": { "type": "string", "minLength": 1 },
                  "entryPoints": { "$ref": "#/definitions/routeOverrides/entryPoints" },
                  "ingressClass": { "$ref": "#/definitions/routeOverrides/ingressClass" },
                  "middlewares": { "$ref": "#/definitions/middlewares" },
                  "tlsSecretName": { "$ref": "#/definitions/routeOverrides/tlsSecretName" }
                }
              }
            }
          }
        }
      }
    },
    "poolDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resources", "securityContext", "containerSecurityContext"],
      "properties": {
        "resources": { "type": "object" },
        "securityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" }
      }
    }
  }
}
